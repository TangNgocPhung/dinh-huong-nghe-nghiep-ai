# Sao chép file này thành ".env" và điền Gemini API key thật của bạn.
# Lấy key tại: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_key_here

# Model chính cho câu hỏi thường ngày (rẻ, nhanh).
# Gói miễn phí: dùng gemini-3.5-flash. Sau khi bật thanh toán: gemini-3.8-flash.
GEMINI_MODEL=gemini-3.5-flash

# Model dùng cho phân tích sâu: đọc tệp, phân tích hồ sơ, xếp hạng Top 10.
# Đổi thành gemini-3.1-pro-preview nếu muốn câu trả lời sâu hơn (tốn tiền hơn nhiều).
GEMINI_DEEP_MODEL=gemini-3.8-flash

# Model dự phòng khi model chính quá tải, cách nhau bằng dấu phẩy.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# Cho phép AI tra Google khi cần số liệu tuyển sinh, học phí (chỉ chạy trên gói trả phí).
# Đang tắt để tiết kiệm; đặt 1 nếu muốn AI trả về số liệu học phí, điểm chuẩn thật.
GEMINI_ENABLE_SEARCH=0

GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_BUDGET=2048
GEMINI_DEEP_THINKING_BUDGET=8192

# Thời gian (giây) tạm bỏ qua một model hoặc công cụ vừa báo hết quota.
GEMINI_COOLDOWN_SECONDS=300

# Danh sách origin frontend được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
